{
  "name": "@findbuddy/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "migrate": "node dist/migrations/runner.js",
    "lint": "eslint src scripts tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@findbuddy/constants": "workspace:*",
    "@findbuddy/contracts": "workspace:*",
    "@findbuddy/types": "workspace:*",
    "@findbuddy/utils": "workspace:*",
    "@findbuddy/validation": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.2",
    "pino": "^9.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@findbuddy/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
