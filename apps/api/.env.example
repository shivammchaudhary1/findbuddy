NODE_ENV=development
HOST=127.0.0.1
PORT=8888
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB Atlas or a local MongoDB instance. Use a separate database per environment.
MONGODB_URI=mongodb://127.0.0.1:27017/findbuddy_local
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Tests that need a live database run only when this points to an explicitly
# test-named database such as findbuddy_test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/findbuddy_test

# Generate an independent random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=findbuddy-api
JWT_AUDIENCE=findbuddy-clients
REFRESH_TOKEN_TTL=30d
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# S3 profile-image uploads. In production, prefer EC2 IAM roles over static keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=findbuddy-media-development
MEDIA_PUBLIC_BASE_URL=https://findbuddy-media-development.s3.ap-south-1.amazonaws.com
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_PRESIGN_TTL=5m
